# api/register, api/login, api/save, ... -> api.php
RewriteEngine On
# Wird unter /ultima4/ ausgeliefert (Apache-Alias). Bei anderem Pfad anpassen.
RewriteBase /ultima4/
RewriteRule ^api/(.+)$ api.php?r=$1 [QSA,L]

# Datenbank/Spielstände nicht direkt ausliefern.
<FilesMatch "\.(sqlite|sqlite-wal|sqlite-shm)$">
    Require all denied
</FilesMatch>
