# Leitet api/register, api/login, ... auf das PHP-Backend um.
# (Wird nur von Apache mit AllowOverride All ausgewertet; der Node.js-Server
# hat seine eigenen Routen und ignoriert diese Datei.)
RewriteEngine On
# Nötig, weil dieses Verzeichnis per Alias unter /ultima4 eingebunden ist.
# Bei anderem URL-Pfad entsprechend anpassen.
RewriteBase /ultima4/
RewriteRule ^api/(.+)$ api.php?r=$1 [QSA,L]
